# ---------------------------------------------------------------------------
# StudyQuest frontend — environment template (set these in the Vercel project)
# Copy to `.env.local` for local development. Only NEXT_PUBLIC_* values exist
# here: every secret lives in the API (see backend/.env.example).
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
# Where the StudyQuest backend is served. Locally the API defaults to :8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Supabase: safe to expose (public, RLS-enforced) ------------------------
# Leave both empty to run against the API's demo identity and sample content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this frontend is publicly served. Used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional public preferences -------------------------------------------
# Default theme when a visitor has saved no preference: light | dark | system
NEXT_PUBLIC_THEME_DEFAULT=system
# Keep the demo banner available even when Supabase is configured.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
